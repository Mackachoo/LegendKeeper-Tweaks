# One key per world. LegendKeeper: Project Settings → Developers → API Keys.
# Use an ADMIN key to create top-level pages and read tags. The project owner needs a paid plan.
LEGENDKEEPER_KEY_OOO=lk_...
# LEGENDKEEPER_KEY_EBERRON=lk_...

# Or a single world:
# LEGENDKEEPER_API_KEY=lk_...
# LEGENDKEEPER_WORLD_NAME=ooo

# Which world to use when Claude doesn't name one (optional with a single world).
# LEGENDKEEPER_DEFAULT_WORLD=ooo

# Set to 1 to expose only the read tools.
LEGENDKEEPER_READ_ONLY=0

# HTTP transport only: the token Claude must send as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Only if you use the tunnel profile in docker-compose.yml.
# CLOUDFLARE_TUNNEL_TOKEN=
