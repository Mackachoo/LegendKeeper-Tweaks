{
  "manifest_version": 3,
  "name": "LegendKeeper Tweaks",
  "version": "0.8.0",
  "description": "Quality-of-life tweaks for LegendKeeper: page tabs, tag shortcuts, tree-preserving filters, cover-image icons and more.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "LegendKeeper Tweaks",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.legendkeeper.com/*",
        "https://legendkeeper.com/*"
      ],
      "js": [
        "src/page-hook.js",
        "src/features/suggestions.js",
        "src/features/tabs.js",
        "src/features/page-extras.js",
        "src/features/bulk-settings.js",
        "src/features/browser-tabs.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.legendkeeper.com/*",
        "https://legendkeeper.com/*"
      ],
      "js": [
        "src/bridge.js",
        "src/settings-button.js"
      ],
      "css": [
        "src/tweaks.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup/*",
        "icons/*"
      ],
      "matches": [
        "https://www.legendkeeper.com/*",
        "https://legendkeeper.com/*"
      ]
    }
  ]
}
